# Python
.venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Models & adapters (quá nặng)
adapters/**
!adapters/.gitkeep
*.bin
*.safetensors
*.gguf

# Data thô / JSON Slither lớn
data/raw/**
!data/raw/.gitkeep
!data/raw/README.md
data/labels/*.jsonl
!data/labels/.gitkeep
!data/labels/schema.example.jsonl
!data/labels/demo_labels.jsonl
!data/labels/labels_v1.jsonl
!data/labels/holdout_sources.json
!data/sft/
!data/sft/**/*.jsonl

# Reports nặng (*.report.json ~2MB) không lên git
reports/**
!reports/.gitkeep
!reports/BAO-CAO-CHI-SO.md
!reports/paper_stats.json
!reports/pred_A.jsonl
!reports/pred_B.jsonl
!reports/pred_C.jsonl
!reports/pred_D.jsonl
!reports/pred_E.jsonl
!reports/pred_E_noR.jsonl
!reports/figures/
!reports/figures/*.png
!reports/figures/manifest.json

# Env / IDE
.env
.idea/
.vscode/
*.swp

